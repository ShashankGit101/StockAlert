# ============================================================
# StockAlert — root .gitignore
# ============================================================

# ── Environment & secrets ───────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Python (backend & cron) ─────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/
env/
ENV/

# ── Node / React Native / Expo ──────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.expo/
.expo-shared/
dist/
web-build/

# ── Expo / EAS ──────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
google-services.json
GoogleService-Info.plist

# ── Metro bundler ───────────────────────────────────────────
.metro-health-check*

# ── iOS ─────────────────────────────────────────────────────
mobile/ios/Pods/
mobile/ios/.xcode.env.local

# ── Android ─────────────────────────────────────────────────
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/key.properties
