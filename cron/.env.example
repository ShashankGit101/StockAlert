# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stockalert

# ── Stock data provider ─────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_key_here

