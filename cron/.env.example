# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stockalert

# ── Stock data provider ─────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_key_here

# ── Push notifications ──────────────────────────────────────
EXPO_ACCESS_TOKEN=your_expo_access_token

# ── Email notifications (Resend) — leave blank to disable ──
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=StockAlert <alerts@yourdomain.com>

# ── Scheduler ───────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60
